# Домен панели и API (DNS должен указывать на этот сервер)
DOMAIN=fuel.example.com
PUBLIC_URL=https://fuel.example.com

# Пароль Postgres (любая длинная случайная строка, например: openssl rand -hex 24)
POSTGRES_PASSWORD=change-me

# Первый пользователь панели. Создаётся при первом запуске, если пользователей ещё нет.
# Сервер не запустится с паролем из этого примера или короче 8 символов.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-too

# Часовой пояс для времени в уведомлениях
TZ=Europe/Moscow

# VLM: ключ OpenRouter и модель по умолчанию (id модели на openrouter.ai, с поддержкой изображений)
VLM_API_KEY=
VLM_MODEL=
# VLM_BASE_URL=https://openrouter.ai/api/v1

# Telegram (необязательно): токен бота от @BotFather. Чаты и типы уведомлений — в панели
TELEGRAM_BOT_TOKEN=
